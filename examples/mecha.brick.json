 "steps": [
  { "n": 1, "title": "双足底板（前黄后白）", "note": "铺设前足黄色 2×4 底板与后足白色 2×4 底板" },
  { "n": 2, "title": "双足 2×4 承重砖与前后 2×2 护盾", "note": "安装深蓝灰 2×4 足砖，并在前足正中扣黑色 2×2 光面板、后足正中扣白色 2×2 光面板" },
  { "n": 3, "title": "双足彩色合页关节（前红黄灰 / 后绿蓝黄）", "note": "前足安装红砖+黄把柄板+灰双夹板，后足安装绿砖+蓝把柄板+黄双夹板，还原拆解图中的彩色脚踝合页" },
  { "n": 4, "title": "下部核心柱、内侧 4 块 2×2 黑夹持竖板与 2×6 裙甲", "note": "立起下部核心砖，前后先扣合 4 块黑色 2×2 竖向夹持板锁紧核心，外侧再扣合前白后黑 2×6 横向裙甲与四角饰片" },
  { "n": 5, "title": "中段 3176 圆孔耳板与四向 SNOT 核心立柱", "note": "铺设中央 3176 带圆孔半圆耳板与两侧黑托板，在其上方四向围合立起 4 颗 11211 侧凸点核心砖" },
  { "n": 6, "title": "上段核心与四翼把柄挂架", "note": "在四向核心砖顶部安装 4 颗 48336 带侧把柄板，圆杆朝外供四片机翼夹持" },
  { "n": 7, "title": "正背 2×4 胸甲与竖立能量柱", "note": "正面扣白色 2×4 横板并在托架上竖立浅灰竖纹柱+透明浅蓝圆片；背面扣红棕 2×4 横板并竖立黑竖纹柱+透明红圆片" },
  { "n": 8, "title": "左右双层夹心装甲与肩部转接能量柱", "note": "先在左右核心侧凸点扣上蓝/黄、白/红 1×4 过渡夹层板，外层再扣黑/深红 2×4 主护板，顶部经白/灰双层转接板竖立左右竖纹能量柱" },
  { "n": 9, "title": "安装四片底孔反扣水平外掠机翼", "note": "在 4 片 2×4 楔形机翼背面底孔反扣 63868 端头单水平夹板，使机翼正面 4 颗凸点完全裸露，端头夹口向内咬合核心把柄" },
  { "n": 10, "title": "子组件：左右黑斜肩与前绿后黄斜甲", "note": "在肩部底板上安装左右黑色 45° 斜肩，正面扣绿色 2×2 斜砖与黄饰条、背面扣黄色 2×2 斜砖与黄饰条" },
  { "n": 11, "title": "子组件：中央 2×2 圆砖与四色透明雷达片", "note": "安装深蓝灰 2×2 圆砖，顶面按实物方位扣上 1 蓝、2 红、1 黄透明圆片" },
  { "n": 12, "title": "装上顶部双斜肩与四色雷达塔", "attach": "head", "note": "将拼好的顶部雷达塔子组件整体扣合到核心立柱顶端" }
 ],
