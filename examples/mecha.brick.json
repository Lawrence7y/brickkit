 "steps": [
  { "n": 1, "title": "双足底板（前黄后白）", "note": "铺设前足黄色 2×4 底板与后足白色 2×4 底板" },
  { "n": 2, "title": "双足 2×4 承重砖与前后 2×2 护盾", "note": "安装深蓝灰 2×4 足砖，并在前足正中扣黑色 2×2 光面板、后足正中扣白色 2×2 光面板" },
  { "n": 3, "title": "双足连接颈与合页挂件", "note": "在双足上方安装 1×2 连接砖、把柄合页板与水平夹板" },
  { "n": 4, "title": "下部 SNOT 核心柱与前后 2×6 横向裙甲", "note": "立起底部黑/深灰 11211 侧凸点砖，正面扣白色 2×6 横板（左黄右灰 1×1 角片扣在 2×6 板凸点上），背面扣黑色 2×6 横板（左黑右红 1×1 角片）" },
  { "n": 5, "title": "中段四向 SNOT 核心立柱", "note": "铺设 2×4 黑色承重板，在其上方四向围合立起 4 颗 11211 侧凸点核心砖" },
  { "n": 6, "title": "上段核心与四翼把柄挂架", "note": "在四向核心砖顶部安装 4 颗 1×2 带侧把柄板" },
  { "n": 7, "title": "正背 2×4 胸甲与竖立能量柱", "note": "正面扣白色 2×4 横板并在托架上竖立浅灰竖纹柱+透明浅蓝圆片；背面扣红棕 2×4 横板并竖立黑竖纹柱+透明红圆片" },
  { "n": 8, "title": "左右 2×4 竖护板与侧向竖立能量柱", "note": "左侧扣黑色 2×4 竖板并竖立浅灰竖纹柱+透明黄方片；右侧扣深红 2×4 竖板并竖立黑竖纹柱+透明红方片" },
  { "n": 9, "title": "安装四片水平外掠机翼", "note": "向左右水平装上前侧两片黄色楔形翼与后侧红/深红楔形翼，并在机翼内侧凸点上扣合黑/棕/红 1×2 夹板" },
  { "n": 10, "title": "子组件：左右黑斜肩与前绿后黄斜甲", "note": "在肩部底板上安装左右黑色 45° 斜肩，正面扣绿色 2×2 斜砖与黄饰条、背面扣黄色 2×2 斜砖与黄饰条" },
  { "n": 11, "title": "子组件：中央 2×2 圆砖与四色透明雷达片", "note": "安装深蓝灰 2×2 圆砖，顶面按实物方位扣上 1 蓝、2 红、1 黄透明圆片" },
  { "n": 12, "title": "装上顶部双斜肩与四色雷达塔", "attach": "head", "note": "将拼好的顶部雷达塔子组件整体扣合到核心立柱顶端" }
 ],
