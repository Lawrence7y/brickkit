{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickkit.dev/contracts/prd-v2-c/render-state.schema.json",
  "title": "renderState v1.0.0 —— 接口标号视图（MV-01）",
  "description": "A 侧 renderState() 的输出契约（MV-01，contracts-1.0 冻结版，自 0.9.0-draft 并入）。只包含几何与 2D↔3D 映射，不含像素；画图与标签排版权归 B（stud-overlay-v2.js）。相机契约：target/distance/viewport/projection 必须显式给定，不接受隐式取景；UI 自动取景时必须把实际 cameraSnapshot 序列化后传入接口。stateHash 只标识模型状态、不标识视图——缓存与标号引用必须同时携带相机参数（cameraSnapshot），不得把「同一模型」误当「同一视图」。",
  "type": "object",
  "required": [
    "ok",
    "kind",
    "renderStateVersion",
    "cameraContract",
    "camera",
    "stateHash",
    "labels",
    "enumerationComplete",
    "truncated"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "commandOk": {
      "type": "boolean",
      "description": "命令是否跑通（与 passed 分离）"
    },
    "passed": {
      "type": "boolean"
    },
    "kind": {
      "const": "renderState"
    },
    "renderStateVersion": {
      "const": "1.0.0"
    },
    "stateHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "标号所绑定的装配状态哈希。跨状态复用标号必须失败。注意：stateHash 只代表模型状态；同一模型 + 不同相机 = 不同视图，缓存键必须同时含 stateHash 与相机快照。"
    },
    "cameraContract": {
      "type": "object",
      "description": "相机语义自描述，供 B 断言自己用的是同一套口径",
      "required": [
        "version",
        "worldUnit",
        "pixelOrigin",
        "upAxis"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "worldUnit": {
          "const": "stud"
        },
        "sourceSpace": {
          "type": "string"
        },
        "sourceToWorld": {
          "type": "object"
        },
        "azimuthDefinition": {
          "type": "string"
        },
        "elevationDefinition": {
          "type": "string"
        },
        "upAxis": {
          "const": "+Y"
        },
        "pixelOrigin": {
          "const": "top-left"
        },
        "pixelAxes": {
          "type": "object"
        },
        "projection": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "perspective",
                "orthographic"
              ]
            },
            "fovYDeg": {
              "type": "number"
            },
            "near": {
              "type": "number"
            },
            "far": {
              "type": "number"
            }
          }
        },
        "handedness": {
          "type": "string"
        }
      }
    },
    "camera": {
      "type": "object",
      "required": [
        "mode",
        "eye",
        "target",
        "distance",
        "fovYDeg",
        "viewport",
        "pixelOrigin"
      ],
      "properties": {
        "mode": {
          "enum": [
            "perspective",
            "orthographic"
          ]
        },
        "eye": {
          "$ref": "#/$defs/vec3"
        },
        "target": {
          "$ref": "#/$defs/vec3"
        },
        "distance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "azimuthDeg": {
          "type": "number"
        },
        "elevationDeg": {
          "type": "number"
        },
        "dir": {
          "$ref": "#/$defs/vec3"
        },
        "up": {
          "$ref": "#/$defs/vec3"
        },
        "fovYDeg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "near": {
          "type": "number"
        },
        "far": {
          "type": "number"
        },
        "aspect": {
          "type": "number"
        },
        "orthoHalfHeight": {
          "type": [
            "number",
            "null"
          ]
        },
        "viewport": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "viewRect": {
          "type": "object",
          "description": "可见区（交互模式下被步骤条压缩时使用）；缺省为整块画布",
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        "pixelOrigin": {
          "const": "top-left"
        }
      },
      "description": "显式相机快照（cameraSnapshot）。必须给全 target/distance/viewport；projection 语义见 cameraContract。UI 自动取景时由 UI 序列化后传入，用户无需手填坐标。"
    },
    "labels": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "tag",
          "pixel",
          "nodeId",
          "partId",
          "connectorId",
          "connectorType",
          "dir",
          "worldPos",
          "worldPosLdu",
          "depth",
          "aliases"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "按屏幕阅读顺序分配的标号，同输入同输出"
          },
          "pixel": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            },
            "description": "[x, y]，左上原点，y 向下"
          },
          "nodeId": {
            "type": "string",
            "description": "零件实例 id（0.2 模型的 p.id）"
          },
          "partId": {
            "type": "string"
          },
          "connectorId": {
            "type": "string",
            "description": "A 的稳定语义接口 ID（ctop#N / cside#N / cantistud#N …）。这是权威键。"
          },
          "connectorType": {
            "type": "string"
          },
          "dir": {
            "enum": [
              "+x",
              "-x",
              "+y",
              "-y",
              "+z",
              "-z"
            ]
          },
          "worldPos": {
            "$ref": "#/$defs/vec3",
            "description": "世界坐标，单位格（y 已按 PLATE 换算）"
          },
          "worldPosLdu": {
            "$ref": "#/$defs/vec3",
            "description": "世界坐标，单位 LDU"
          },
          "depth": {
            "type": "number",
            "description": "到相机平面的正距离，越大越远"
          },
          "aliases": {
            "type": "object",
            "required": [
              "bStyle",
              "bare"
            ],
            "description": "兼容别名。权威键仍是 connectorId；别名必须与资产修订一起使用。",
            "properties": {
              "bStyle": {
                "type": "string",
                "description": "stud_top_N / stud_side_N / antistud_N …"
              },
              "bare": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "裸 stud_N，仅对顶凸点有定义；侧凸点为 null（否则与顶凸点撞名）"
              }
            }
          },
          "occupied": {
            "type": "boolean"
          },
          "occupiedBy": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "enumerationComplete": {
      "type": "boolean",
      "description": "false 表示被 maxLabels 截断，不得声称「视口内可见接口已穷尽」"
    },
    "truncated": {
      "type": "boolean"
    },
    "maxLabels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "candidatesInView": {
      "type": "integer",
      "description": "通过全部剔除后、截断前的接口数"
    },
    "skipped": {
      "type": "object",
      "description": "每个剔除原因都必须可解释，不能静默丢弃",
      "properties": {
        "backFacing": {
          "type": "integer"
        },
        "outOfView": {
          "type": "integer"
        },
        "occluded": {
          "type": "integer"
        },
        "occupied": {
          "type": "integer"
        },
        "outOfFocus": {
          "type": "integer"
        },
        "unsupported": {
          "type": "integer"
        }
      }
    },
    "diagnostics": {
      "type": "array"
    },
    "elapsedMs": {
      "type": "number"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "diagnostics"
        ],
        "properties": {
          "diagnostics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "code",
                "severity",
                "msg"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "stale-state",
                    "render-invalid-request"
                  ]
                },
                "severity": {
                  "type": "string"
                },
                "msg": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  }
}
