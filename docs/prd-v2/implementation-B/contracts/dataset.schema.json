{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickkit.org/schemas/brickvlm-dataset-1.0.json",
  "title": "BrickVLMDatasetSampleC3",
  "description": "BrickVLM 领域多模态训练与评测样本契约 (C3)。覆盖 understand_step, understand_structure, select_action, repair_local 四类核心任务，绑定 stateHash 并区分类别与来源。",
  "type": "object",
  "required": [
    "sampleId",
    "protocolVersion",
    "taskType",
    "provenance",
    "assetLock",
    "images",
    "stateRef",
    "inventory",
    "candidates",
    "target",
    "verification"
  ],
  "properties": {
    "sampleId": {
      "type": "string",
      "pattern": "^smp-[a-zA-Z0-9_-]+$"
    },
    "protocolVersion": {
      "type": "string",
      "const": "1.0"
    },
    "taskType": {
      "type": "string",
      "enum": [
        "understand_step",
        "understand_structure",
        "select_action",
        "repair_local"
      ]
    },
    "provenance": {
      "type": "object",
      "required": ["sourceFamilyId", "sourceModelId", "sourceKind", "split"],
      "properties": {
        "sourceFamilyId": { "type": "string" },
        "sourceModelId": { "type": "string" },
        "sourceKind": { "type": "string", "enum": ["real_manual", "synthetic_assembly", "curriculum_rule"] },
        "split": { "type": "string", "enum": ["train", "validation", "holdout_test"] },
        "difficulty": { "type": "string", "enum": ["basic_stack", "snot", "bracket", "subassembly", "accessory"] }
      }
    },
    "assetLock": {
      "type": "object",
      "required": ["catalogVersion", "engineRevision"],
      "properties": {
        "catalogVersion": { "type": "string" },
        "engineRevision": { "type": "string" }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "imagePath", "imageSha256", "labeled"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["target_manual_step", "current_rendered_state", "candidate_part", "auxiliary_view", "repair_diagnosis"]
          },
          "imagePath": { "type": "string" },
          "imageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "cameraPose": {
            "type": "object",
            "properties": {
              "azimuth": { "type": "number" },
              "elevation": { "type": "number" }
            }
          },
          "labeled": {
            "type": "boolean",
            "description": "是否带有 2D 接口视觉标号 (Set-of-Mark)"
          },
          "connectorLabelMapRef": {
            "type": ["string", "null"],
            "description": "若 labeled=true，引用 2D 标号映射到 3D 稳定接口的 JSON 文件"
          }
        }
      }
    },
    "stateRef": {
      "type": "object",
      "required": ["taskId", "stepNumber", "stateHash"],
      "properties": {
        "taskId": { "type": "string" },
        "stepNumber": { "type": "integer", "minimum": 0 },
        "stateHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "inventory": {
      "type": "array",
      "description": "当前任务当前步骤可用的未消耗零件 Token 列表",
      "items": {
        "type": "object",
        "required": ["tokenId", "partId", "colorId"],
        "properties": {
          "tokenId": { "type": "string" },
          "partId": { "type": "string" },
          "colorId": { "type": "integer" }
        }
      }
    },
    "candidates": {
      "type": "object",
      "required": ["enumerationComplete", "truncated", "items"],
      "properties": {
        "enumerationComplete": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["candidateId", "parentInstanceId", "parentConnectorId", "childPartId", "childConnectorId", "orientationId"],
            "properties": {
              "candidateId": { "type": "string" },
              "op": { "type": "string", "enum": ["attach_part", "attach_assembly", "place_root", "abstain", "undo", "detach", "replace"] },
              "isAssembly": { "type": "boolean" },
              "subassemblyTemplateId": { "type": ["string", "null"] },
              "parentInstanceId": { "type": "string" },
              "parentConnectorId": { "type": "string" },
              "childPartId": { "type": "string" },
              "childConnectorId": { "type": "string" },
              "orientationId": { "type": "integer" },
              "candidateHash": { "type": "string" }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "description": "模型预测目标（动作选择、新增件或结构判断）",
      "required": ["primaryAction"],
      "properties": {
        "primaryAction": {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": { "type": "string", "enum": ["attach_part", "attach_assembly", "place_root", "abstain", "undo", "detach", "replace"] },
            "selectedCandidateId": { "type": "string" },
            "subassemblyTemplateId": { "type": ["string", "null"] },
            "consumedTokenId": { "type": "string" },
            "consumedTokenIds": { "type": "array", "items": { "type": "string" } },
            "assignedInstanceId": { "type": "string" },
            "abstainReason": { "type": "string" }
          }
        },
        "equivalentCandidates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "由于几何对称等价的全部正确候选 candidateId"
        },
        "stepUnderstanding": {
          "type": "object",
          "properties": {
            "partsAdded": { "type": "array", "items": { "type": "object" } },
            "isFlip": { "type": "boolean" },
            "isAssemblyEvent": { "type": "boolean" }
          }
        },
        "structureDiagnosis": {
          "type": "object",
          "properties": {
            "hasStructuralError": { "type": "boolean" },
            "errorType": { "type": "string" },
            "faultyPartInstances": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["isGeometricallyLegal", "hasManualGroundTruth", "verifiedBy"],
      "properties": {
        "isGeometricallyLegal": { "type": "boolean" },
        "hasManualGroundTruth": { "type": "boolean" },
        "verifiedBy": { "type": "string" },
        "evidenceNote": { "type": "string" }
      }
    }
  }
}
