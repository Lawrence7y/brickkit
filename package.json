{
  "name": "brickkit",
  "version": "0.2.0",
  "description": "乐高实物模型（多角度照片）→ 3D 拼装演示、爆炸图、拼装图纸：数据格式、拍摄规范、校验、查看器与 Harness 命令行",
  "scripts": {
    "build": "node build.mjs",
    "demo": "node examples/gen-cottage.mjs",
    "validate": "node cli/brickkit.mjs validate examples/cottage.brick.json --photos examples/cottage.photos.json --pretty",
    "booklet": "node cli/brickkit.mjs booklet examples/cottage.brick.json -o out/cottage.booklet.pdf",
    "qa": "node tools/qa_run.mjs"
  },
  "keywords": [
    "lego",
    "ldraw",
    "brick",
    "three.js",
    "instructions",
    "exploded-view",
    "agent"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "^0.186.1"
  },
  "bin": {
    "brickkit": "cli/brickkit.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
